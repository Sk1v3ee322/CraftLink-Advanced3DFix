+/// Copy `src` into `dst` at `(dx, dy)`, clipped to `dst`.
+fn blit(src: &Image, dst: &mut Image, dx: i64, dy: i64) {
+    let (dw, sw) = (dst.width as i64, src.width as i64);
+    let x0 = (-dx).max(0);
+    let x1 = (dw - dx).min(sw);
+    if x0 >= x1 {
