+        footage: cx.footage.as_ref(),
+        expr: cx.expr.as_deref(),
+        accel: cx.accel.as_deref(),
+        item: &item,
+        path,
+        storage: None,
+        label: "CraftLink master".to_string(),
+        nested_switches: cx.nested_switches,
+
+        caches: None,
+        renderer: None,
+        gpu_frames: None,
+    };
+    exporter.export(&job, progress)
