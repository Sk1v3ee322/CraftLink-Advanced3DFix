+/// CraftLink: whether a re-rendered linked master is waiting to be read (see
+/// `filmcraft_engine::craftlink_bridge`).
+#[cfg(not(target_arch = "wasm32"))]
+fn craftlink_notify_pending(dir: &std::path::Path) -> bool {
+    std::fs::read_dir(dir).map(|entries| entries.flatten().any(|e| e.path().extension().is_some_and(|x| x == "notify"))).unwrap_or(false)
+}
+
+/// CraftLink: drop the consumed notices.
+#[cfg(not(target_arch = "wasm32"))]
+fn craftlink_clear_notices(dir: &std::path::Path) {
+    for e in std::fs::read_dir(dir).into_iter().flatten().flatten() {
+        let p = e.path();
+        if p.extension().is_some_and(|x| x == "notify") {
+            let _ = std::fs::remove_file(p);
+        }
+    }
+}
