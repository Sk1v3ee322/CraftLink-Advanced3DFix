+/// Whether the project shows a CraftLink master (a media file inside the link's `CraftLink`
+/// folder). The interface then polls the link's spool folder several times a second, so a render
+/// that EffectCraft finished shows at once instead of on the next timed scan.
+pub fn watches_linked_master(p: &Project) -> bool {
+    let folder = crate::craftlink_bridge::LINK_FOLDER;
+    p.items.values().any(|i| match &i.kind {
+        ItemKind::Media(m) => match &m.media {
+            MediaRef::File { path } => std::path::Path::new(path).components().any(|c| c.as_os_str() == std::ffi::OsStr::new(folder)),
+            _ => false,
+        },
+        _ => false,
+    })
+}
